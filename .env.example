# 后端服务配置
HOST=127.0.0.1
PORT=8000

# LLM 配置（OpenAI 兼容接口，当前为阿里云 MaaS）
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://llm-tpumbyuk4rdtbg2k.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# LangSmith 追踪（自动追踪 LangGraph 智能体每一步）
LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=AI-tablepet

# 天气 API（和风天气）
WEATHER_API_KEY=your_weather_key_here

# 文件操作白名单目录（分号分隔，空=不限制仅限开发）
FILE_WHITELIST=

# TTS 配置
TTS_PROVIDER=edge
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# 百度 TTS（预留，暂不启用）
BAIDU_TTS_APP_ID=
BAIDU_TTS_API_KEY=
BAIDU_TTS_SECRET_KEY=

# ===== MCP 配置 =====
MCP_ENABLED=true
MCP_FILESYSTEM_ROOTS=D:\study\Java\内项目\全栈\AI桌宠
POSTGRES_URI=postgresql://postgres:123456@localhost:5432/langgraph
